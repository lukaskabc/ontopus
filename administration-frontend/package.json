{
  "name": "administration-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ci": "npm ci --ignore-scripts",
    "update": "npx npm-check-updates -u -c 7d",
    "dev": "vite",
    "build": "npm run lint && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0 --format unix",
    "lint:fix": "eslint . --fix",
    "prettier:write": "prettier -u -w --ignore-path .gitignore ./src",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hallysonh/pageable": "1.0.3",
    "@mui/icons-material": "latest-v7",
    "@mui/material": "latest-v7",
    "@mui/x-data-grid": "latest-v7",
    "@mui/x-tree-view": "latest-v7",
    "@rjsf/core": "^6.7.1",
    "@rjsf/mui": "^6.7.1",
    "@rjsf/utils": "^6.7.1",
    "@rjsf/validator-ajv8": "^6.7.1",
    "@toolpad/core": "0.16.0",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-chained-backend": "5.0.6",
    "i18next-http-backend": "4.0.1",
    "i18next-localstorage-backend": "4.3.2",
    "i18next-resources-to-backend": "1.2.3",
    "lodash-es": "4.18.1",
    "preact": "10.29.8",
    "preact-iso": "2.12.2",
    "react-dropzone": "20.1.0",
    "react-i18next": "17.0.11",
    "react-promise-tracker": "2.1.1",
    "sass": "1.102.0",
    "wouter-preact": "3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@types/lodash": "4.17.25",
    "eslint": "10.8.1",
    "eslint-formatter-unix": "9.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vite-plugin-svgr": "5.2.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "eslint --max-warnings=0",
    "**/*": "npm run prettier:write"
  }
}
